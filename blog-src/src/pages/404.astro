---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header     from '../components/Header.astro';
import Footer     from '../components/Footer.astro';

const base = '/blogs';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you were looking for could not be found."
  noindex={true}
>
  <Header />

  <main id="main-content" class="min-h-[70vh] flex items-center justify-center px-5">
    <div class="text-center max-w-md">
      <div class="font-mono text-7xl font-bold text-accent/20 mb-4" aria-hidden="true">404</div>
      <h1 class="font-display font-semibold text-2xl text-white mb-3">Page not found</h1>
      <p class="text-txt-secondary leading-relaxed mb-8">
        The article or page you were looking for does not exist, or may have moved.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={base + '/'}
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm
                  bg-accent text-txt-inverse hover:bg-accent-bright transition-colors no-underline">
          Back to Articles
        </a>
        <a href="https://anmolksachan.github.io" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm
                  border border-border-base text-txt-secondary hover:text-txt-primary
                  hover:border-border-strong transition-colors no-underline">
          Portfolio ↗
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
