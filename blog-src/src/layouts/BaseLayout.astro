---
import '../styles/global.css';

interface Props {
  title:       string;
  description: string;
  image?:      string;
  canonical?:  string;
  type?:       'website' | 'article';
  pubDate?:    string;
  tags?:       string[];
  noindex?:    boolean;
}

const {
  title,
  description,
  image,
  canonical,
  type = 'website',
  pubDate,
  tags = [],
  noindex = false,
} = Astro.props;

const siteUrl  = 'https://anmolksachan.github.io';
const base     = '/blogs';
const pageUrl  = canonical || (siteUrl + Astro.url.pathname);
const ogImage  = image || `${siteUrl}/img/og-default.png`;
const fullTitle = title.includes('Anmol') ? title : `${title} — Anmol K Sachan`;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <!-- Canonical -->
  <link rel="canonical" href={pageUrl} />

  <!-- OpenGraph -->
  <meta property="og:type"        content={type} />
  <meta property="og:site_name"   content="Anmol K Sachan — Security Research" />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={pageUrl} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  {type === 'article' && pubDate && (
    <meta property="article:published_time" content={pubDate} />
  )}
  {tags.map(tag => <meta property="article:tag" content={tag} />)}

  <!-- Twitter card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@FR13ND0x7f" />
  <meta name="twitter:creator"     content="@FR13ND0x7f" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml"
        title="Anmol K Sachan — Security Research"
        href={`${siteUrl}${base}/rss.xml`} />

  <!-- Favicon (inherits from parent site) -->
  <link rel="icon" href="/img/logo.ico" type="image/x-icon" />

  <!-- JSON-LD -->
  {type === 'article' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context":          "https://schema.org",
      "@type":             "Article",
      "headline":          title,
      "description":       description,
      "image":             ogImage,
      "author":            { "@type": "Person", "name": "Anmol K Sachan",
                             "url": "https://anmolksachan.github.io" },
      "publisher":         { "@type": "Person", "name": "Anmol K Sachan" },
      "datePublished":     pubDate,
      "mainEntityOfPage":  { "@type": "WebPage", "@id": pageUrl },
    })} />
  )}

  {type === 'website' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type":    "Blog",
      "name":     "Anmol K Sachan — Security Research",
      "url":      siteUrl + base,
      "author":   { "@type": "Person", "name": "Anmol K Sachan" },
    })} />
  )}
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-txt-inverse focus:rounded-lg focus:font-semibold">
    Skip to main content
  </a>

  <slot />

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Image lightbox">
    <img id="lightbox-img" src="" alt="" />
  </div>

  <!-- Cmd+K search dialog -->
  <div id="cmd-dialog" role="dialog" aria-modal="true" aria-label="Search">
    <div id="cmd-dialog-box">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-border-subtle">
        <svg class="w-4 h-4 text-txt-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input id="cmd-input" type="search" placeholder="Search articles…"
               class="flex-1 bg-transparent text-txt-primary text-sm outline-none placeholder-txt-muted font-mono"
               autocomplete="off" spellcheck="false" />
        <kbd class="text-2xs font-mono px-1.5 py-0.5 rounded border border-border-subtle text-txt-muted">ESC</kbd>
      </div>
      <div id="cmd-results" class="max-h-96 overflow-y-auto p-2"></div>
    </div>
  </div>

  <!-- Global scripts -->
  <script>
    // ── Lightbox ───────────────────────────────────────────────────────
    document.addEventListener('click', (e) => {
      const img = e.target as HTMLElement;
      if (img.tagName === 'IMG' && img.closest('.article-content')) {
        const lb  = document.getElementById('lightbox')!;
        const lbi = document.getElementById('lightbox-img') as HTMLImageElement;
        lbi.src = (img as HTMLImageElement).src;
        lbi.alt = (img as HTMLImageElement).alt;
        lb.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
    document.getElementById('lightbox')?.addEventListener('click', () => {
      document.getElementById('lightbox')!.classList.remove('active');
      document.body.style.overflow = '';
    });

    // ── Code copy buttons ──────────────────────────────────────────────
    document.querySelectorAll('.article-content pre').forEach(pre => {
      const btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.textContent = 'copy';
      btn.setAttribute('aria-label', 'Copy code');
      pre.appendChild(btn);
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const code = pre.querySelector('code')?.textContent ?? '';
        await navigator.clipboard.writeText(code).catch(() => {});
        btn.textContent = 'copied!';
        btn.style.color = '#00e673';
        setTimeout(() => { btn.textContent = 'copy'; btn.style.color = ''; }, 2000);
      });
    });

    // ── Cmd+K search ──────────────────────────────────────────────────
    const cmdDialog = document.getElementById('cmd-dialog')!;
    const cmdInput  = document.getElementById('cmd-input')  as HTMLInputElement;
    const cmdRes    = document.getElementById('cmd-results')!;

    function openCmd() {
      cmdDialog.classList.add('active');
      cmdInput.focus();
      document.body.style.overflow = 'hidden';
    }
    function closeCmd() {
      cmdDialog.classList.remove('active');
      cmdInput.value = '';
      cmdRes.innerHTML = '';
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        cmdDialog.classList.contains('active') ? closeCmd() : openCmd();
      }
      if (e.key === 'Escape') {
        closeCmd();
        (document.getElementById('lightbox') as HTMLElement).classList.remove('active');
        document.body.style.overflow = '';
      }
    });
    cmdDialog.addEventListener('click', (e) => {
      if (e.target === cmdDialog) closeCmd();
    });

    // Load Fuse.js search index from pre-built JSON
    let fuseInstance: any = null;
    async function initSearch() {
      if (fuseInstance) return;
      try {
        const [FuseModule, data] = await Promise.all([
          import('fuse.js'),
          fetch('/blogs/search-index.json').then(r => r.json()),
        ]);
        const Fuse = FuseModule.default ?? FuseModule;
        fuseInstance = new Fuse(data, {
          keys: ['title','excerpt','tags'],
          threshold: 0.35,
          includeScore: true,
        });
      } catch {}
    }

    cmdInput.addEventListener('focus', initSearch);
    cmdInput.addEventListener('input', async () => {
      await initSearch();
      const q = cmdInput.value.trim();
      if (!q || !fuseInstance) { cmdRes.innerHTML = ''; return; }
      const results = fuseInstance.search(q).slice(0, 8);
      if (!results.length) {
        cmdRes.innerHTML = '<p class="text-txt-muted text-sm text-center py-6">No results found</p>';
        return;
      }
      cmdRes.innerHTML = results.map(({ item }: any) => `
        <a href="/blogs/${item.slug}/" class="search-results-item no-underline group">
          <div class="shrink-0 w-10 h-10 rounded bg-bg-overlay flex items-center justify-center text-xs font-mono text-txt-muted border border-border-subtle">
            ${item.readingTime}m
          </div>
          <div class="min-w-0">
            <div class="text-sm font-medium text-txt-primary group-hover:text-accent truncate transition-colors">${item.title}</div>
            <div class="text-xs text-txt-muted truncate mt-0.5">${item.excerpt?.slice(0, 90)}…</div>
          </div>
        </a>
      `).join('');
    });

    // ── Scroll animations ──────────────────────────────────────────────
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.fade-up-on-scroll').forEach(el => io.observe(el));
  </script>
</body>
</html>
